# REAL TEST PROFILE — 20 USDT, Binance spot only
# Keep these two flags false until you have installed and verified the bot.
TRADING_MODE=paper
LIVE_TRADING=false
LIVE_TRADING_ARMED=false
LIVE_TRANSFER_ARMED=false
EXCHANGE=binance
EXCHANGES=binance
QUOTE_CURRENCY=USDT
TEST_CAPITAL_USDT=20
SCAN_UNIVERSE=30
RADAR_LIMIT=10
MAX_POSITIONS=5
ENTRY_SCORE=0.30
# Money/time profile: target 0.25 net profit per 1 unit of allocated capital;
# at 90 seconds the lower 0.20 floor may be accepted to recycle the position.
PROFIT_TARGET_MODE=money_time
PROFIT_TARGET_PER_UNIT=0.25
PROFIT_FLOOR_PER_UNIT=0.20
TARGET_TRADE_INTERVAL_SEC=90
MAX_TRADE_HOLD_SEC=180
# Put the expected round-trip trading fee here for net-profit targeting.
ESTIMATED_ROUND_TRIP_FEE_PCT=0
TAKE_PROFIT_PCT=0.6
STOP_LOSS_PCT=0.3
# Checkbox default: enabled. Disable to wait for recovery instead of SL exit.
STOP_LOSS_ENABLED=true
SCALPER_SETTINGS_FILE=scalper_settings.json
DAILY_LOSS_LIMIT_USDT=3
POLL_SECONDS=20
LEVERAGE=1
BINANCE_SANDBOX=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
