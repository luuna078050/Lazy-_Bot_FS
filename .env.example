TRADING_MODE=paper
LIVE_TRADING=false
LIVE_TRADING_ARMED=false
LIVE_TRANSFER_ARMED=false
EXCHANGES=binance,kraken,okx,coinbase
SYMBOL=BTC/USDT
MAX_POSITION_USDT=5
RISK_PER_TRADE_USDT=1
DAILY_LOSS_LIMIT_USDT=3
LEVERAGE=1
# Money/time profit mode hides percentages from the strategy control.
PROFIT_TARGET_MODE=money_time
PROFIT_TARGET_PER_UNIT=0.25
PROFIT_FLOOR_PER_UNIT=0.20
TARGET_TRADE_INTERVAL_SEC=90
MAX_TRADE_HOLD_SEC=180
ESTIMATED_ROUND_TRIP_FEE_PCT=0
# Legacy percentage TP remains available only when PROFIT_TARGET_MODE=percent.
TAKE_PROFIT_PCT=0.6
STOP_LOSS_PCT=0.3
# User checkbox: true = enforce SL; false = wait for recovery instead of loss-based exit.
STOP_LOSS_ENABLED=true
SCALPER_SETTINGS_FILE=scalper_settings.json

# Per-exchange credentials. Keep withdrawals disabled unless explicitly audited.
BINANCE_API_KEY=
BINANCE_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_API_PASSWORD=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSWORD=
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_PASSWORD=

# Optional sandbox flags per venue
BINANCE_SANDBOX=false
KRAKEN_SANDBOX=false
OKX_SANDBOX=false
COINBASE_SANDBOX=false
