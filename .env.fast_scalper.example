# FAST SCALPER 3M — Binance Spot
# Safe default: PAPER. Do not put API secrets in Git.
FAST_SCALPER_LIVE=false
LIVE_TRADING=false
LIVE_TRADING_ARMED=false
EXCHANGE=binance
EXCHANGES=binance

# Capital controlled by this bot only.
FAST_SCALPER_CAPITAL_USDT=100
# 2 or 3 pairs. Allocation percentages must total exactly 100.
FAST_SCALPER_PAIRS=DGB/USDT,ZRO/USDT,TUT/USDT
FAST_SCALPER_ALLOCATIONS=30,30,40

# Fixed execution timeframe/budget: 3 minutes = 180 seconds.
# Profit is absolute USDT, not percentage.
FAST_SCALPER_MIN_PROFIT_USDT=0.20
FAST_SCALPER_TARGET_PROFIT_USDT=0.30
FAST_SCALPER_ROUND_TRIP_FEE_PCT=0.20

# Existing SL checkbox: enabled by default for live safety.
FAST_SCALPER_STOP_LOSS_ENABLED=true
FAST_SCALPER_STOP_LOSS_PCT=0.50
FAST_SCALPER_STATE_FILE=fast_scalper_3m_state.json

# Binance credentials. Use a trading key with withdrawals disabled and IP restrictions.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_SANDBOX=false
